# Compose environment for the NAS deployment (copied to $NAS_STACK_DIR/.env by `make deploy-nas`).
# No secrets here: the API key and Kalshi key files are mounted from ./secrets on the NAS.
DATABASE_URL=postgresql+psycopg://harness:harness@postgres:5432/harness
ODDS_API_KEY_FILE=/run/secrets/odds_api_key
ODDS_API_BOOKMAKERS=pinnacle,betonlineag,lowvig,draftkings,fanduel,novig,kalshi
TZ=UTC
# Run the app containers as the NAS user so the 0600 secret files are readable without chown/sudo.
APP_UID=1000
APP_GID=10
# Host port for the health/dashboard endpoint (8080 is taken by SABnzbd on the NAS).
SERVE_PORT=8180
# Paper posture, asserted positively. Absence of a live-trading flag proves nothing to a later
# reader; a committed 0 in every revision of this file is a provable statement that the deployed
# harness places no real orders. See docs/legal-posture.md. Flipping either value is a gate.
LIVE_TRADING=0
HARNESS_MODE=paper
# U5 (Task 4b step 5): the gate row is judged on sharp_two_sided from the phase 3 deploy on
GATE_VARIANT=sharp_two_sided
