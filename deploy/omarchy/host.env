# Controller routing only; runtime credentials and effective settings stay on the host.
NAS_IP=192.168.12.127
NAS_USER=trey
NAS_STACK_DIR=/srv/sports-harness
COMPOSE_COMMAND=./sports-compose
# Phase 4.6 (addendum §6): where Compose publishes the home-network listener, and the only
# Origin its write routes accept. Committed here as the record and as the value the runtime
# `.env` on the host carries; docker-compose.yml's defaults are the same two values, so a
# runtime `.env` without them behaves identically. Never 0.0.0.0 and never a routable
# address: Docker publishes ahead of ufw, so this binding is the boundary. The listener
# itself exists only while the three files in docs/runbooks/lan-listener.md are in place.
LAN_ADDR=192.168.12.127
LAN_PORT=8443
